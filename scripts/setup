#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
node -e 'if (Number(process.versions.node.split(".")[0]) < 22) { console.error("Care Circle requires Node 22 or newer"); process.exit(1); }'
command -v python3 >/dev/null
"$ROOT/scripts/install-hooks"
printf '%s\n' 'Local repository setup complete. Follow services/brain/README.md for the separate GBrain prerequisite.'
