#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
node <<'NODE'
const { spawnSync } = require('node:child_process');
if (Number(process.versions.node.split('.')[0]) < 22) {
  console.error('Care Circle requires Node 22 or newer');
  process.exit(1);
}
const bun = spawnSync('bun', ['--version'], { encoding: 'utf8', timeout: 5000, maxBuffer: 1024 });
const version = bun.status === 0 && !bun.error && /^(\d+)\.(\d+)\.(\d+)(?:\+[A-Za-z0-9.-]+)?$/.exec(bun.stdout.trim());
if (!version || [Number(version[1]), Number(version[2]), Number(version[3])].some(value => !Number.isSafeInteger(value)) ||
    !(Number(version[1]) > 1 || (Number(version[1]) === 1 && (Number(version[2]) > 3 || (Number(version[2]) === 3 && Number(version[3]) >= 11))))) {
  console.error('Care Circle requires Bun 1.3.11 or newer on PATH; its read-only version check must finish within 5 seconds.');
  process.exit(1);
}
NODE
command -v python3 >/dev/null
command -v ps >/dev/null
"$ROOT/scripts/install-hooks"
printf '%s\n' 'Local repository setup complete. Follow services/brain/README.md for the separate GBrain prerequisite.'
