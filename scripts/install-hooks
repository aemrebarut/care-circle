#!/usr/bin/env python3
"""Install the repository secret-check hook without replacing an unknown hook."""

import os
from pathlib import Path
import stat
import subprocess
import sys


def stop(message):
    print(f"install-hooks: {message}", file=sys.stderr)
    raise SystemExit(1)


def git(root, *args):
    return subprocess.run(
        ["git", "-C", str(root), *args],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )


def main():
    if len(sys.argv) != 1:
        stop("run scripts/install-hooks without arguments.")

    root = Path(__file__).resolve().parent.parent
    result = git(root, "rev-parse", "--show-toplevel")
    if result.returncode != 0:
        stop("the script must be inside a Git working repository.")
    if Path(os.fsdecode(result.stdout).rstrip("\n")).resolve() != root:
        stop("the script must be in this repository's scripts directory.")

    configured = git(root, "config", "--get", "core.hooksPath")
    if configured.returncode == 0:
        stop("core.hooksPath is configured; preserve that setup and integrate the public hook manually.")
    if configured.returncode != 1:
        stop("could not check Git hook configuration; no hook was changed.")

    source = root / "scripts" / "hooks" / "pre-commit"
    if not source.is_file() or source.is_symlink():
        stop("the public scripts/hooks/pre-commit file is missing or is a symlink.")
    if not os.access(source, os.X_OK):
        stop("scripts/hooks/pre-commit must be executable before installation.")

    result = git(root, "rev-parse", "--absolute-git-dir")
    if result.returncode != 0:
        stop("could not locate this repository's Git directory.")
    hooks = Path(os.fsdecode(result.stdout).rstrip("\n")) / "hooks"
    if hooks.is_symlink():
        stop("the Git hooks directory is a symlink; no hook was changed.")
    hooks.mkdir(exist_ok=True)
    target = hooks / "pre-commit"

    try:
        os.symlink(os.path.relpath(source, hooks), target)
        print("install-hooks: installed the public secret-check hook.")
        return
    except FileExistsError:
        pass

    if target.is_symlink():
        if target.resolve() == source.resolve():
            print("install-hooks: the public secret-check hook is already installed.")
            return
        stop("an unfamiliar pre-commit symlink exists; it was preserved without changes.")

    # Accept the original local hook only when every byte matches the public one.
    # Keep its contents and inode, so no unrecognized hook can be overwritten.
    try:
        descriptor = os.open(target, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(descriptor, "rb") as existing:
            existing_stat = os.fstat(existing.fileno())
            if not stat.S_ISREG(existing_stat.st_mode):
                stop("an unfamiliar pre-commit entry exists; it was preserved without changes.")
            if existing.read() != source.read_bytes():
                stop("an unfamiliar pre-commit hook exists; it was preserved without changes.")
            os.fchmod(existing.fileno(), stat.S_IMODE(existing_stat.st_mode) | 0o111)
    except OSError:
        stop("could not safely inspect the existing pre-commit hook; it was preserved.")
    print("install-hooks: an identical secret-check hook is already installed.")


if __name__ == "__main__":
    try:
        main()
    except (OSError, subprocess.SubprocessError):
        stop("installation failed; inspect local hook setup before retrying.")
