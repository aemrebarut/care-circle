#!/usr/bin/env python3
import re, subprocess, sys
names = subprocess.check_output(['git','diff','--cached','--name-only','-z']).decode().split('\0')
for name in names:
    if name and (re.search(r'(^|/)\.env($|\.)', name) or any(x in name for x in ['auth.json','credentials.json','.pem','.key'])):
        print('pre-commit: credential-like filename blocked; keep credentials outside the repository.', file=sys.stderr)
        sys.exit(1)
patch = subprocess.check_output(['git','diff','--cached','-U0','--no-color']).decode(errors='replace')
patterns = [r'sk-[A-Za-z0-9_-]{20,}', r'ghp_[A-Za-z0-9]{20,}', r'github_pat_[A-Za-z0-9_]{20,}', r'AKIA[0-9A-Z]{16}', r'xox[baprs]-[A-Za-z0-9-]{10,}', r'-----BEGIN [A-Z ]*PRIVATE KEY-----', r'''(?i)(api[_-]?key|secret|token|password)["' ]*[:=]\s*["'][A-Za-z0-9_-]{16,}["']''']
for line in patch.splitlines():
    if line.startswith('+') and not line.startswith('+++') and any(re.search(p,line) for p in patterns):
        print('pre-commit: possible secret in added content; blocked without printing it.', file=sys.stderr)
        sys.exit(1)
